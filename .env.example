APP_NAME=Zenith Signer
PORT=8080
BASE_URL=http://localhost:8080
DB_PATH=/app/data/signatures.db

# Autenticação Microsoft Entra ID (mesmas credenciais do Outline)
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=seu-client-id-aqui
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# Admins autorizados a ver o relatório completo em /admin (separados por vírgula)
ADMIN_EMAILS=admin@dominio.com.br

# Chave HMAC para assinatura dos cookies de sessão e dos tokens anti-CSRF
# (se vazio, gera uma aleatória por execução e todos são deslogados a cada restart).
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Origens autorizadas a incorporar o widget /assinar em <iframe> (separadas por vírgula).
# Formato: https://host[:porta] — aceita curinga de subdomínio (https://*.empresa.com.br).
# Se vazio, o widget só pode ser incorporado pelo próprio Zenith Signer.
ALLOWED_EMBED_ORIGINS=https://wiki.dominio.com.br

# IPs/CIDRs dos proxies reversos confiáveis (separados por vírgula). Só destes
# o X-Forwarded-For / X-Real-IP é aceito para registrar o IP real do colaborador.
# Se vazio, os cabeçalhos são ignorados e o IP da conexão TCP é registrado.
# Exemplo para Nginx/Traefik no mesmo host Docker: 172.16.0.0/12
TRUSTED_PROXIES=

# SMTP Office 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@dominio.com.br
SMTP_PASSWORD=sua-senha-aqui
SMTP_FROM_EMAIL=Assinador <seu-email@dominio.com.br>
SMTP_REPLY_EMAIL=Assinador <seu-email@dominio.com.br>

# Personalização visual do e-mail de confirmação
EMAIL_LOGO_URL=
EMAIL_ACCENT_COLOR=#8BC74B
EMAIL_SIGNATURE_NAME=Zenith Signer

# Observabilidade e Logs (LOG_FORMAT: json em produção ou text para desenvolvimento)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=
